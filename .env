# Test-only settings for the guactest stack. These are throwaway test
# credentials, not secrets. Change a value, then run `docker compose up -d`.

# Guacamole version. Only 1.6.0 (and its RCs) have arm64 images on Docker Hub.
# For older versions on arm64, see README.md ("Other versions").
GUAC_VERSION=1.6.0
GUACD_IMAGE=guacamole/guacd
GUACAMOLE_IMAGE=guacamole/guacamole

# Host ports (bound to 127.0.0.1 only).
GUAC_HTTP_PORT=47880
SSH_HOST_PORT=47822

# Guacamole login.
GUAC_USER=guacuser
GUAC_PASSWORD=guacpass

# SSH connection. Empty means guacd's default.
SSH_CONNECTION_NAME=ssh-target
SSH_USER=tester
SSH_PASSWORD=tester
SSH_FONT_NAME=
SSH_FONT_SIZE=
# e.g. black-white, gray-black, green-black, white-black,
# or "foreground:rgb:00/ff/00;background:rgb:00/00/00"
SSH_COLOR_SCHEME=
SSH_SCROLLBACK=
SSH_TERMINAL_TYPE=
SSH_BACKSPACE=
SSH_LOCALE=
SSH_TIMEZONE=
SSH_READ_ONLY=
SSH_DISABLE_COPY=
SSH_DISABLE_PASTE=
SSH_SERVER_ALIVE_INTERVAL=
