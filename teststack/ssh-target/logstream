#!/bin/bash
# Prints log lines forever, like kubectl logs -f or journalctl -f.
# logstream [SECONDS_BETWEEN_LINES]
#
# Ctrl+C must always stop it. Without the trap, bash goes on when sleep ends
# just as Ctrl+C comes, and $(date) can swallow Ctrl+C, so the time comes
# from printf instead. The trap ends the script by SIGINT, as the shell
# expects of a program stopped with Ctrl+C.
trap 'trap - INT; kill -INT $$' INT
export TZ=UTC
n=0
while :; do
  n=$((n + 1))
  level=INFO
  [ $((n % 10)) = 0 ] && level=WARN
  printf '%(%H:%M:%S)T %s worker[%d]: tick seq=%06d queue=%d\n' -1 "$level" $((n % 4)) "$n" $((n * 7 % 97))
  sleep "${1:-0.2}"
done
